#!/usr/bin/env bash
# Desktop launcher: start the yoink server (if not already running), open a
# dedicated browser app-window, and — if we started the server — shut it down
# cleanly when the window closes. No hanging servers, no locked databases.
set -euo pipefail

cd "$(dirname "$0")/.."

PORT="${YOINK_PORT:-8090}"
URL="http://127.0.0.1:$PORT"
DATA_DIR="${YOINK_DATA_DIR:-$HOME/.local/share/yoink}"
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/yoink"
SERVER_PID=""
BROWSER_PID=""
CLEANED=0

mkdir -p "$DATA_DIR" "$LOG_DIR"
exec 2>>"$LOG_DIR/launcher.log"  # keep a trace when launched from the app menu

server_up() { curl -sf --max-time 2 "$URL/api/settings" >/dev/null 2>&1; }

fail() {
    echo "$(date -Is) ERROR: $*" >&2
    # The app menu gives no terminal — surface the error on the desktop.
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a Yoink "Yoink failed to start" "$*"
    elif command -v kdialog >/dev/null 2>&1; then
        kdialog --error "Yoink failed to start: $*" || true
    fi
    exit 1
}

cleanup() {
    [ "$CLEANED" = 1 ] && return 0
    CLEANED=1
    if [ -n "$BROWSER_PID" ] && kill -0 "$BROWSER_PID" 2>/dev/null; then
        kill -TERM "$BROWSER_PID" 2>/dev/null || true
    fi
    # Only stop the server if this launcher started it. TERM triggers uvicorn's
    # graceful shutdown: running downloads are cancelled (partial files are kept
    # and resumable) and every job reaches a terminal state in the database.
    if [ -n "$SERVER_PID" ] && kill -0 "$SERVER_PID" 2>/dev/null; then
        kill -TERM "$SERVER_PID" 2>/dev/null || true
        for _ in $(seq 1 150); do  # up to 30s: covers the job-cancel window
            kill -0 "$SERVER_PID" 2>/dev/null || return 0
            sleep 0.2
        done
        echo "yoink: server did not stop gracefully, killing" >&2
        kill -KILL "$SERVER_PID" 2>/dev/null || true
    fi
}
trap cleanup EXIT INT TERM

if ! server_up; then
    # The venv is only (re)built when missing, via uv — which lives in
    # ~/.local/bin and is NOT on the app-menu session PATH, so resolve it
    # explicitly. Normal launches skip this and start the venv binary directly
    # (no `uv run` wrapper process, so SIGTERM reaches uvicorn itself).
    if [ ! -x .venv/bin/yoink ]; then
        UV=$(command -v uv || true)
        [ -z "$UV" ] && for c in "$HOME/.local/bin/uv" "$HOME/.cargo/bin/uv"; do
            [ -x "$c" ] && UV="$c" && break
        done
        [ -z "$UV" ] && fail "no .venv and uv not found — run 'uv sync' in $PWD once"
        "$UV" sync --frozen --quiet || "$UV" sync --quiet \
            || fail "uv sync failed — see $LOG_DIR/launcher.log"
    fi
    .venv/bin/yoink --port "$PORT" >> "$LOG_DIR/server.log" 2>&1 &
    SERVER_PID=$!
    for _ in $(seq 1 100); do
        server_up && break
        if ! kill -0 "$SERVER_PID" 2>/dev/null; then
            fail "server failed to start — see $LOG_DIR/server.log"
        fi
        sleep 0.2
    done
    server_up || fail "server did not become ready — see $LOG_DIR/server.log"
fi

command -v chromium-browser >/dev/null 2>&1 || [ -n "${YOINK_BROWSER:-}" ] \
    || fail "chromium-browser not found (set YOINK_BROWSER to use another browser)"

# Dedicated app window. The private user-data-dir gives yoink its own browser
# process we can wait on; a second launch of this script joins that process,
# exits immediately, and leaves the first launcher owning the server. The
# browser runs in the background and is wait-ed on so signals (logout, kill)
# interrupt immediately instead of being deferred until the window closes.
if [ -n "${YOINK_BROWSER:-}" ]; then
    # e.g. YOINK_BROWSER="firefox --new-window" (note: no auto-shutdown if the
    # browser command returns before the window closes)
    $YOINK_BROWSER "$URL" &
else
    chromium-browser --app="$URL" \
        --user-data-dir="$DATA_DIR/browser-profile" \
        --no-first-run --no-default-browser-check \
        >/dev/null 2>&1 &
fi
BROWSER_PID=$!
wait "$BROWSER_PID" || true
